          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Priya Nair\",\n  \"email\": \"priya.test@example.com\",\n  \"age\": 22\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\",()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"userId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. List users (search + page)",
